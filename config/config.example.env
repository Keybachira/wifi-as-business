# Configuracao de exemplo do WiFi Controller (generico, tudo local).
# Copie para "config.env" na pasta do executavel, ou exporte as variaveis.
# Ordem de leitura: variaveis de ambiente > config.env / .env.
# Tambem pode apontar para outro ficheiro com WIFIC_FICHEIRO=caminho.

# --- Identidade (tudo configuravel, sem valores fixos) ---
WIFIC_NOME=WiFi Controller
# Moeda apresentada (vazio = sem simbolo; ex.: Kz, USD, EUR, BRL)
WIFIC_MOEDA=
# Prefixo dos codigos de vale (1-4 caracteres)
WIFIC_PREFIXO_VALE=VA

# --- Servidor ---
WIFIC_PORTA=8080
WIFIC_ENDERECO=0.0.0.0
WIFIC_AMBIENTE=desenvolvimento

# --- Base de dados (tudo guardado localmente) ---
WIFIC_BANCO=data/controller.db
WIFIC_MIGRACOES=migrations

# --- Autenticacao ---
WIFIC_DURACAO_SESSAO=12h
WIFIC_CUSTO_HASH=12

# Primeira conta (opcional). O sistema nao cria contas sozinho:
# sem estas variaveis, crie a conta via POST /api/v1/auth/primeira-conta
# (so funciona enquanto nao existir nenhuma conta).
# WIFIC_ADMIN_EMAIL=operador@exemplo.local
# WIFIC_ADMIN_SENHA=MudarEstaSenha1

# Planos iniciais (opcional). Sem isto, o sistema arranca sem planos.
# Formato: Nome;preco_centavos;duracao_min;velocidade_kbps[;dados_mb][;dispositivos]
# WIFIC_PLANOS_INICIAIS=1 Hora;100;60;5000;1024;1, 1 Dia;500;1440;20000;8192;2

# --- Router MikroTik (vazio desativa a integracao) ---
WIFIC_MIKROTIK_ENDERECO=192.168.88.1
WIFIC_MIKROTIK_USUARIO=admin
WIFIC_MIKROTIK_SENHA=
WIFIC_MIKROTIK_PORTA_API=8728

# --- Servidor RADIUS ---
WIFIC_RADIUS_ENDERECO=127.0.0.1
WIFIC_RADIUS_PORTA=1812
# Segredo partilhado com o router (vazio desativa o servidor RADIUS)
WIFIC_RADIUS_SEGREDO=

# --- pfSense (alternativa ao MikroTik; vazio desativa) ---
WIFIC_PFSENSE_ENDERECO=
WIFIC_PFSENSE_USUARIO=admin
WIFIC_PFSENSE_SENHA=
WIFIC_PFSENSE_CHAVE_API=
WIFIC_PFSENSE_ALIAS=
