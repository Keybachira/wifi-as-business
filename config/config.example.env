# Configuracao de exemplo do WiFi Controller.
# Copie para um ficheiro .env ou exporte estas variaveis antes de arrancar.
# Em Windows PowerShell:  $env:WIFIC_PORTA = 9090

# --- Servidor ---
WIFIC_PORTA=8080
WIFIC_ENDERECO=0.0.0.0
WIFIC_AMBIENTE=desenvolvimento

# --- Base de dados ---
WIFIC_BANCO=data/controller.db
WIFIC_MIGRACOES=migrations

# --- Autenticacao ---
WIFIC_DURACAO_SESSAO=12h
WIFIC_CUSTO_HASH=12

# Conta de dono criada na primeira execucao.
# Se nao forem definidas, sao geradas e mostradas no arranque.
WIFIC_ADMIN_EMAIL=admin@kimbo.ao
WIFIC_ADMIN_SENHA=Kimbo2026

# --- Router MikroTik (vazio desativa a integracao) ---
WIFIC_MIKROTIK_ENDERECO=192.168.88.1
WIFIC_MIKROTIK_USUARIO=admin
WIFIC_MIKROTIK_SENHA=
WIFIC_MIKROTIK_PORTA_API=8728

# --- Servidor RADIUS ---
WIFIC_RADIUS_ENDERECO=127.0.0.1
WIFIC_RADIUS_PORTA=1812